# Example environment variables for Channels DVR Manager

# Unsplash API key for image search in manual recording creation
VITE_UNSPLASH_CLIENT_ID=your_unsplash_client_id

# Backend API proxy URL (used by nginx to forward /api requests)
API_PROXY_URL=https://your-backend-url.example.com

# DVR scheduler base URL (where the Channels DVR server is running)
CHANNELS_DVR_URL=http://www.channels.local

# Cron expression used by the background rule matcher
CHANNELS_DVR_CRON=0 3 * * *

# Run a scan immediately on container startup (true/false)
CHANNELS_DVR_RUN_IMMEDIATELY=true

# Log file for the DVR scheduler. The script truncates this file before each run.
DVR_LOG_FILE=/var/log/dvr-scheduler.log

# Stream Base URL for viewing live TV in the Guide tab
VITE_STREAM_URL=https://your-backend-url.example.com

